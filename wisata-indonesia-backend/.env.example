# Salin file ini menjadi .env lalu sesuaikan.
PORT=4000
NODE_ENV=development

# MongoDB lokal (default)
MONGO_URI=mongodb://127.0.0.1:27017/wisata_indonesia

# WAJIB diganti dengan string acak panjang (terutama saat production)
JWT_SECRET=ganti_dengan_string_acak_yang_panjang
JWT_EXPIRE=30d

# Asal frontend yang diizinkan CORS (pisahkan dengan koma). Default: localhost:5173 & localhost:4173
CORS_ORIGIN=http://localhost:5173
